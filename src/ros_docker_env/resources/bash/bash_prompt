git_prompt() {
    local branch

    branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null) ||
        branch=$(git rev-parse --short HEAD 2>/dev/null) ||
        return

    printf '%s' "$branch"
}

. /etc/os-release
DISTRO="$ID"


PS1='\[\033[01;32m\]\u\[\033[00m\]@\[\033[01;31m\]$UBUNTU_CODENAME-$VERSION_ID\[\033[00m\]:\[\033[01;34m\]\W\[\033[01;33m\] $(git_prompt)\[\033[00m\]$ '
